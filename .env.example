APP_NAME=Gulf Breeze Air Backend
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gulf_breeze_air
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_ECHO_SQL=false

OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_AGENT_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=alloy
OPENAI_WEBHOOK_SECRET=
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=30
SEMANTIC_MAX_TOP_K=50
AGENT_MAX_TOOL_ROUNDS=8
AGENT_MAX_HISTORY_MESSAGES=20

VOICE_AGENT_ENABLED=true
VOICE_AGENT_API_BASE_URL=http://localhost:8000
VOICE_AGENT_API_TIMEOUT_SECONDS=12
VOICE_REALTIME_TIMEOUT_SECONDS=10
VOICE_SIDEBAND_RETRY_DELAYS_MS=200,400,800,1200
VOICE_GREETING_ENABLED=true
VOICE_GREETING_TEXT=Welcome to Gulf Breeze Air. How can I help you today?

TWILIO_PHONE_NUMBER=
WEATHER_TIMEOUT_SECONDS=3
WEATHER_CACHE_TTL_SECONDS=2700
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SIP_TRUNK_SID=
